package com.sujal.expensetracker.view;

import com.sujal.expensetracker.DatabaseHelper;
import javax.swing.*;
import java.awt.*;
import java.time.LocalDate;

public class AddTransactionFrame extends JFrame {

    public AddTransactionFrame() {
        setTitle("Add New Transaction");
        setSize(520, 580);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(DISPOSE_ON_CLOSE);

        JPanel panel = new JPanel();
        panel.setBackground(new Color(18, 18, 28));
        panel.setLayout(null);

        JLabel title = new JLabel("Add New Transaction", SwingConstants.CENTER);
        title.setFont(new Font("Segoe UI", Font.BOLD, 24));
        title.setForeground(Color.WHITE);
        title.setBounds(50, 30, 420, 40);
        panel.add(title);

        // Type
        JLabel typeLabel = new JLabel("Type:");
        typeLabel.setBounds(50, 100, 150, 30);
        typeLabel.setForeground(Color.WHITE);
        panel.add(typeLabel);

        JComboBox<String> typeBox = new JComboBox<>(new String[]{"EXPENSE", "INCOME"});
        typeBox.setBounds(200, 100, 250, 40);
        panel.add(typeBox);

        // Amount
        JLabel amtLabel = new JLabel("Amount (₹):");
        amtLabel.setBounds(50, 160, 150, 30);
        amtLabel.setForeground(Color.WHITE);
        panel.add(amtLabel);

        JTextField amountField = new JTextField();
        amountField.setBounds(200, 160, 250, 40);
        panel.add(amountField);

        // Category
        JLabel catLabel = new JLabel("Category:");
        catLabel.setBounds(50, 220, 150, 30);
        catLabel.setForeground(Color.WHITE);
        panel.add(catLabel);

        JComboBox<String> catBox = new JComboBox<>(new String[]{"Food", "Transport", "Shopping", "Bills", "Entertainment", "Salary", "Others"});
        catBox.setBounds(200, 220, 250, 40);
        panel.add(catBox);

        // Description
        JLabel descLabel = new JLabel("Description:");
        descLabel.setBounds(50, 280, 150, 30);
        descLabel.setForeground(Color.WHITE);
        panel.add(descLabel);

        JTextField descField = new JTextField();
        descField.setBounds(200, 280, 250, 40);
        panel.add(descField);

        // Date
        JLabel dateLabel = new JLabel("Date:");
        dateLabel.setBounds(50, 340, 150, 30);
        dateLabel.setForeground(Color.WHITE);
        panel.add(dateLabel);

        JTextField dateField = new JTextField(LocalDate.now().toString());
        dateField.setBounds(200, 340, 250, 40);
        panel.add(dateField);

        // Save Button
        JButton saveBtn = new JButton("SAVE TRANSACTION");
        saveBtn.setBounds(80, 430, 350, 55);
        saveBtn.setBackground(new Color(0, 200, 100));
        saveBtn.setForeground(Color.WHITE);
        saveBtn.setFont(new Font("Segoe UI", Font.BOLD, 16));

        saveBtn.addActionListener(e -> {
            try {
                String type = (String) typeBox.getSelectedItem();
                double amount = Double.parseDouble(amountField.getText());
                String category = (String) catBox.getSelectedItem();
                String desc = descField.getText();

                DatabaseHelper.addTransaction(type, amount, category, desc);
                
                JOptionPane.showMessageDialog(this, "Transaction Added Successfully! ✅", "Success", JOptionPane.INFORMATION_MESSAGE);
                dispose();
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Please enter valid amount!", "Error", JOptionPane.ERROR_MESSAGE);
            }
        });

        panel.add(saveBtn);
        add(panel);
    }
}